%% Authoritative editable source for the hybrid request-flow diagram.
sequenceDiagram
    autonumber

    box rgb(17,40,65) Client
        participant U as User / client
    end
    box rgb(18,52,46) Azure Functions
        participant F as Hosted Skill
        participant A as MAF agent
        participant W as Local tool adapter
    end
    box rgb(16,52,82) Governed services
        participant G as APIM AI Gateway
        participant M as Foundry model
        participant R as Remote MCP
    end
    box rgb(43,43,36) Invocation isolation
        participant X as ACA sandbox
    end

    U->>F: POST agent request
    activate F
    F->>X: Create invocation sandbox
    X-->>F: Sandbox ready with local tool manifest

    F->>A: Start agent turn
    activate A
    A->>G: Invoke model
    G->>M: Forward with managed identity
    M-->>A: Tool calls

    A->>G: Invoke remote MCP tool
    G->>R: Execute governed MCP operation
    R-->>A: Return remote tool result via APIM

    A->>W: Invoke sandbox-backed tool
    W->>X: Execute queued local call
    X-->>A: Return local tool result via adapter

    A->>G: Synthesize final response
    G->>M: Invoke model with managed identity
    M-->>A: Return final response via APIM
    A-->>F: Complete agent turn
    deactivate A

    F->>X: Delete invocation sandbox
    X-->>F: Deletion accepted
    F-->>U: Return completed agent response
    deactivate F
