# Keep Functions runtime config files using LF line endings on all
# platforms. Without this, Windows checkouts with `core.autocrlf=true`
# can return `host.json` / `local.settings.json` files with CRLF that
# some tooling chokes on.
host*.json   text eol=lf
local.settings*.json* text eol=lf

# Prettier defaults to LF. Keep the TypeScript executor stable on Windows CI,
# where core.autocrlf would otherwise rewrite every checked-out file to CRLF.
integrations/vally-executor-azure-functions/** text eol=lf
